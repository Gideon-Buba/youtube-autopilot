# ── Shared ────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
GROQ_API_KEY=your_groq_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
HF_API_TOKEN=your_hugging_face_api_token

# ── YouTube Autopilot (Nigerian history channel) ───────────────────────────────
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id
PEXELS_API_KEY=your_pexels_api_key
YOUTUBE_CLIENT_ID=your_youtube_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_oauth_client_secret
# token saved to: .youtube_token.json

# ── Theophany (theology channel — UC2y3I4eHej3oZDtz46dHisA) ───────────────────
THEOPHANY_VOICE_ID=your_theophany_elevenlabs_voice_id  # calmer voice; falls back to ELEVENLABS_VOICE_ID
THEOPHANY_YOUTUBE_CLIENT_ID=your_theophany_oauth_client_id
THEOPHANY_YOUTUBE_CLIENT_SECRET=your_theophany_oauth_client_secret
